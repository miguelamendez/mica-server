{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/engine-v1.schema.json",
  "title": "Mica engine manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "backend", "installer", "launcher", "device_target", "hardware", "artifact_formats"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "status": {"enum": ["current", "candidate"]},
    "backend": {"enum": ["mlx", "gguf", "vllm"]},
    "installer": {"enum": ["cmake-llama", "cmake-audio", "python-mlx", "python-vllm"]},
    "launcher": {"enum": ["llama-server", "audio-server", "mlx-lm", "mlx-vlm", "mlx-audio", "vllm"]},
    "device_target": {"type": "string", "minLength": 1},
    "hardware": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "artifact_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://github\\.com/"},
        "revision": {"anyOf": [{"const": "latest"}, {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"}]}
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "runtime_directory": {"type": "string"},
        "server_executable": {"type": "string"},
        "quantizer_executable": {"type": "string"},
        "build_targets": {"type": "array", "items": {"type": "string"}},
        "version_arguments": {"type": "array", "items": {"type": "string"}},
        "environment_group": {"type": "string"},
        "python_packages": {"type": "array", "items": {"type": "string"}},
        "cmake_definitions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string"}}}
      }
    }
  }
}
