{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/vocabulary-v1.schema.json",
  "title": "Mica model and operation vocabulary v1",
  "description": "Shared identifiers for the next-generation manifests. Listing an identifier here does not mean Mica can serve it yet.",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "modality": {"enum": ["text", "image", "video", "audio", "embedding"]},
    "input_modality": {"enum": ["text", "image", "video", "audio"]},
    "input_modalities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/input_modality"}
    },
    "modalities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/modality"}
    },
    "ability": {
      "enum": [
        "text_generation", "instruction_following", "tool_calling",
        "reasoning", "structured_output", "embedding_generation", "image_understanding",
        "video_understanding", "audio_understanding", "speech_recognition", "speech_translation",
        "speaker_diarization", "speech_synthesis", "voice_conditioning",
        "general_audio_generation", "music_generation", "audio_transformation",
        "image_generation", "image_editing", "video_generation", "video_editing"
      ]
    },
    "operation": {
      "enum": [
        "text.generate", "chat.generate", "embedding.generate", "decisions.score",
        "audio.transcribe", "audio.translate", "audio.diarize",
        "audio.synthesize_speech", "audio.generate", "audio.transform",
        "image.generate", "image.edit", "video.generate", "video.edit"
      ]
    },
    "task": {
      "enum": [
        "chat", "coding", "ocr", "visual_question_answering", "video_question_answering",
        "audio_question_answering", "tool_calling", "structured_extraction", "decision_scoring",
        "transcription", "speech_translation", "speaker_diarization", "text_to_speech",
        "voice_cloning", "embedding", "retrieval", "image_generation", "image_editing",
        "video_generation", "video_editing", "audio_generation", "music_generation", "audio_transformation"
      ],
      "description": "Intended model uses. Several tasks can use one operation; one model can use several endpoints when its selected engine implements the interactions."
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "required_inputs", "outputs"],
      "properties": {
        "operation": {"$ref": "#/$defs/operation"},
        "required_inputs": {"$ref": "#/$defs/input_modalities"},
        "optional_inputs": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/input_modality"}
        },
        "outputs": {"$ref": "#/$defs/modalities"},
        "description": {"type": "string"}
      }
    }
  }
}
