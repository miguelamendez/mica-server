{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/model-v2.schema.json",
  "title": "Mica model manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "description",
    "source_repository",
    "license",
    "input_modalities",
    "output_modalities",
    "abilities",
    "supported_interactions",
    "artifacts"
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "url"
      ],
      "properties": {
        "kind": {
          "enum": [
            "paper",
            "code",
            "model-card",
            "reproducibility",
            "documentation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^/?#\\s]+([/?#][^\\s]*)?$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "tokenLimit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 2147483647
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "model",
            "vision-projector",
            "mtp-drafter",
            "dflash-drafter",
            "tokenizer",
            "processor",
            "codec",
            "adapter",
            "text-encoder",
            "image-encoder",
            "audio-encoder",
            "vae",
            "scheduler",
            "diffusion-transformer",
            "vocoder",
            "config",
            "license"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repository_path": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "license"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 3
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "estimated_memory_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Device-independent resident storage proxy in decimal MB, not a measured peak."
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": 2
    },
    "id": {
      "$ref": "vocabulary-v1.schema.json#/$defs/id"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_repository": {
      "type": "string",
      "minLength": 3
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "memory_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiler",
        "results"
      ],
      "description": "Offline measured model-component memory evidence, not workload policy or a reservation override.",
      "properties": {
        "profiler": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "results": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "license": {
      "enum": [
        "apache-2.0",
        "mit",
        "bsd-2-clause",
        "bsd-3-clause",
        "isc",
        "openmdw-1.1"
      ]
    },
    "catalog_visible": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "input_modalities": {
      "$ref": "vocabulary-v1.schema.json#/$defs/input_modalities"
    },
    "output_modalities": {
      "$ref": "vocabulary-v1.schema.json#/$defs/modalities"
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "vocabulary-v1.schema.json#/$defs/ability"
      }
    },
    "supported_interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "vocabulary-v1.schema.json#/$defs/interaction"
      }
    },
    "tool_call_formats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "thinking_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "thinking_budget_supported": {
      "type": "boolean"
    },
    "native_context_tokens": {
      "$ref": "#/$defs/tokenLimit",
      "description": "Native total token/position capacity including input and output, not a trained input length. Null when unknown or inapplicable. Source belongs in references."
    },
    "recommended_context_tokens": {
      "$ref": "#/$defs/tokenLimit",
      "description": "One explicitly sourced recommended total context, at most native_context_tokens. Null when unpublished; not inferred from output recommendations or workload budgets."
    },
    "max_output_tokens": {
      "$ref": "#/$defs/tokenLimit",
      "description": "Explicitly published supported generation ceiling or verified training-output limit. Null when unpublished. Examples, generation defaults and benchmark recommendations are not hard limits."
    },
    "mlx_converter": {
      "type": "string"
    },
    "mlx_quantization_profile": {
      "type": "string"
    },
    "gguf_family": {
      "type": "string"
    },
    "gguf_parallel_slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "startup_priority": {
      "type": "integer",
      "minimum": 0
    },
    "required": {
      "type": "boolean"
    },
    "required_by_backend": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "mlx",
          "gguf",
          "vllm"
        ]
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "format",
          "quantization_type",
          "repository",
          "revision",
          "reservation_gib",
          "compatible_engines",
          "files"
        ],
        "properties": {
          "id": {
            "$ref": "vocabulary-v1.schema.json#/$defs/id"
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "quantization_type": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 3
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
          },
          "reservation_gib": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "kv_bytes_per_token_f16": {
            "type": "integer",
            "minimum": 0
          },
          "gguf_block_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024,
            "description": "Verified decoder block count for conservative partial-GPU memory planning."
          },
          "image_min_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384,
            "description": "Native llama-server vision preprocessing floor; requires a GGUF vision projector. Zero retains engine defaults."
          },
          "image_max_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384,
            "description": "Native llama-server vision token ceiling per image; requires a GGUF projector. Zero retains engine defaults."
          },
          "load_path": {
            "type": "string",
            "minLength": 1
          },
          "compatible_engines": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "vocabulary-v1.schema.json#/$defs/id"
            }
          },
          "required_compatibility": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "minimum_engine_commit": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/file"
            }
          },
          "memory_estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "kv_status"
            ],
            "properties": {
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "kv_status": {
                "enum": [
                  "verified",
                  "unknown",
                  "not-applicable"
                ]
              },
              "fixed_state_mb": {
                "type": "number",
                "minimum": 0
              },
              "runtime_overhead_mb": {
                "type": "number",
                "minimum": 0
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checkpoints": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "kv_groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "layers",
                    "key_width",
                    "value_width"
                  ],
                  "properties": {
                    "layers": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048576
                    },
                    "key_width": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048576
                    },
                    "value_width": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1048576
                    },
                    "component_role": {
                      "type": "string"
                    },
                    "capacity_tokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sliding_window_tokens": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1048576
                    },
                    "key_precision": {
                      "enum": [
                        "q4",
                        "q8",
                        "f16",
                        "bf16"
                      ]
                    },
                    "value_precision": {
                      "enum": [
                        "q4",
                        "q8",
                        "f16",
                        "bf16"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
