{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/app-v1.schema.json",
  "title": "app-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "interfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["cli", "mcp", "tui", "web", "background"]}
    },
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]+)?/[^\\s@#]*$"
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            {
              "const": "."
            }
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        }
      },
      "required": [
        "repository",
        "path"
      ]
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "files"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 67108864
              },
              "url": {
                "type": "string",
                "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]+)?/[^\\s@#]*$"
              },
              "executable": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ]
          }
        }
      },
      "required": [
        "format",
        "files"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "chat.generate",
              "text.generate",
              "audio.transcribe",
              "audio.translate",
              "audio.synthesize_speech",
              "audio.diarize",
              "embedding.generate",
              "image.generate",
              "image.edit",
              "video.generate",
              "video.edit",
              "audio.generate",
              "audio.transform",
              "decisions.score"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "operations"
      ]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "microphone",
          "clipboard",
          "files",
          "network",
          "accessibility",
          "global-hotkeys"
        ]
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static_entry": {
          "description": "Verified HTML package file served directly; mutually exclusive with process launch fields.",
          "type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.html$"
        },
        "executable": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            {
              "pattern": "^\\{app_dir\\}/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            }
          ]
        },
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "tui_arguments": {
          "description": "Foreground interactive launch arguments used by app open; executable is the same verified launcher. Supports app_dir, mica_config, mica_root and workload placeholders.",
          "type": "array", "maxItems": 64,
          "items": {"type": "string", "maxLength": 4096}
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9/_-]*$"
        }
      },
      "oneOf": [
        {"required": ["static_entry"], "maxProperties": 1},
        {"required": ["executable", "arguments"], "not": {"required": ["static_entry"]}}
      ],
      "dependentRequired": {
        "port": [
          "path"
        ],
        "path": [
          "port"
        ]
      }
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
          },
          "file": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file",
          "description"
        ]
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"launch": {"required": ["tui_arguments"]}}, "required": ["launch"]},
    "then": {"required": ["interfaces"], "properties": {"interfaces": {"contains": {"const": "tui"}}}}
  }],
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "version",
    "source",
    "distribution",
    "requirements",
    "permissions",
    "launch",
    "workloads"
  ]
}
