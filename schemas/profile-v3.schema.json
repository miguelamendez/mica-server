{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/profile-v3.schema.json",
  "title": "Mica profile schema 3",
  "description": "The data contract for YAML-only shareable Mica profiles.",
  "type": "object",
  "required": ["schema", "id", "models"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 3},
    "id": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "maxLength": 4096},
    "available": {"type": "boolean"},
    "mode": {"type": "string", "minLength": 1, "maxLength": 128},
    "memory": {"$ref": "#/$defs/memory"},
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "nonNegativeNumber": {"type": "number", "minimum": 0},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_ram_gib": {"$ref": "#/$defs/nonNegativeNumber"},
        "maximum_vram_gib": {"$ref": "#/$defs/nonNegativeNumber"},
        "safety_reserve_gib": {"$ref": "#/$defs/nonNegativeNumber"},
        "maximum_resident_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_total_tokens": {"type": "integer", "minimum": 2}
      }
    },
    "batching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "kvCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "enum": ["q4", "q8", "auto", "runtime-managed", "not-applicable"]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["auto", "fixed"]},
        "device": {
          "type": "string",
          "pattern": "^(auto|cpu|(accelerator|cuda|rocm|xpu|metal):[0-9]+)$"
        },
        "gpu_layers": {"type": "integer", "minimum": -1, "maximum": 999},
        "ram_reservation_gib": {"type": "number", "minimum": -1},
        "vram_reservation_gib": {"type": "number", "minimum": -1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "fixed"}}, "required": ["mode"]},
          "then": {"required": ["device"]}
        }
      ]
    },
    "source": {
      "type": "object",
      "required": ["repository", "revision", "license"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(https://huggingface\\.co/)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "trust_remote_code": {"const": false}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(https://huggingface\\.co/)?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "format": {"enum": ["mlx", "gguf", "safetensors", "compressed-tensors"]},
        "quantization": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "quantization_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "projector": {"type": "string", "maxLength": 1024},
        "size_bytes": {"type": "integer", "minimum": 0},
        "size_gib": {"$ref": "#/$defs/nonNegativeNumber"},
        "projector_size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "projector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reservation_gib": {"$ref": "#/$defs/nonNegativeNumber"},
        "size_source": {"type": "string", "maxLength": 256}
      }
    },
    "model": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "execution": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "maxLength": 4096},
        "tags": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "maxLength": 128}
        },
        "modality": {
          "enum": ["asr", "tts", "text-to-text", "img-text-to-text", "video-text-to-text", "image-video-to-text"]
        },
        "engine": {"type": "string", "minLength": 1, "maxLength": 128},
        "family": {"type": "string", "maxLength": 128},
        "declared_context_tokens": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/source"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "context": {"$ref": "#/$defs/context"},
        "batching": {"$ref": "#/$defs/batching"},
        "kv_cache": {"$ref": "#/$defs/kvCache"},
        "placement": {"$ref": "#/$defs/placement"},
        "residency": {"enum": ["pinned", "warm", "on-demand", "ephemeral"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "startup": {"type": "boolean"},
        "idle_seconds": {"type": "integer", "minimum": 0}
      },
      "oneOf": [
        {"required": ["execution"]},
        {"required": ["modality", "engine", "source", "artifact"]}
      ]
    }
  }
}
