{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miguelamendez/mica-server/schemas/model-v1.schema.json",
  "title": "Mica model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "capability", "description", "source_repository", "license", "input_modalities", "output_modalities", "artifacts"],
  "$defs": {
    "tokenClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["tokens", "source"],
      "properties": {"tokens": {"type": "integer", "minimum": 1}, "source": {"type": "string", "minLength": 1}}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "size_bytes"],
      "properties": {
        "role": {"enum": ["model", "vision-projector", "mtp-drafter", "dflash-drafter", "tokenizer", "processor", "codec", "adapter"]},
        "path": {"type": "string", "minLength": 1},
        "repository_path": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["repository", "revision", "license"],
          "properties": {
            "repository": {"type": "string"}, "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
            "license": {"type": "string"}
          }
        }
      }
    }
  },
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "capability": {"enum": ["text", "vision", "asr", "tts"]},
    "description": {"type": "string", "minLength": 1},
    "source_repository": {"type": "string", "minLength": 3},
    "declared_context_tokens": {"type": "integer", "minimum": 0},
    "license": {"enum": ["apache-2.0", "mit", "bsd-2-clause", "bsd-3-clause", "isc"]},
    "catalog_visible": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "input_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "image", "video", "audio"]}},
    "output_modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "image", "video", "audio"]}},
    "tool_call_formats": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "thinking_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "on", "low", "medium", "xhigh"]}},
    "thinking_budget_supported": {"type": "boolean"},
    "trained_context_tokens": {"$ref": "#/$defs/tokenClaim"},
    "useful_context_tokens": {"$ref": "#/$defs/tokenClaim"},
    "supported_output_tokens": {"$ref": "#/$defs/tokenClaim"},
    "trained_output_tokens": {"$ref": "#/$defs/tokenClaim"},
    "mlx_converter": {"type": "string"},
    "mlx_quantization_profile": {"type": "string"},
    "gguf_family": {"type": "string"},
    "gguf_parallel_slots": {"type": "integer", "minimum": 1, "maximum": 16},
    "startup_priority": {"type": "integer", "minimum": 0},
    "required": {"type": "boolean"},
    "required_by_backend": {"type": "object", "propertyNames": {"enum": ["mlx", "gguf", "vllm"]}, "additionalProperties": {"type": "boolean"}},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "backend", "engine", "format", "quantization_type", "repository", "revision", "reservation_gib", "files"],
        "properties": {
          "id": {"type": "string"}, "backend": {"enum": ["mlx", "gguf", "vllm"]},
          "engine": {"type": "string"}, "format": {"type": "string"},
          "quantization_type": {"type": "string"}, "repository": {"type": "string"},
          "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"},
          "reservation_gib": {"type": "number", "exclusiveMinimum": 0},
          "required_features": {"type": "array", "items": {"type": "string"}},
          "minimum_engine_commit": {"type": "string"},
          "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
        }
      }
    }
  }
}
