{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/miguelamendez/mica-server/main/schemas/engine-v2.schema.json",
  "title": "Mica engine manifest v2",
  "description": "Endpoint contracts describe callable adapter surfaces; compatibility tags only gate artifact loading and do not imply an operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "description", "backend", "installer", "launcher", "device_target", "hardware", "artifact_formats", "endpoint_contracts"],
  "properties": {
    "schema": {"const": 2},
    "id": {"$ref": "vocabulary-v1.schema.json#/$defs/id"},
    "description": {"type": "string", "pattern": "\\S", "description": "Natural-language explanation of what this engine runs and its installation/runtime constraints."},
    "status": {"enum": ["current", "candidate"]},
    "backend": {"type": "string", "minLength": 1},
    "installer": {"type": "string", "minLength": 1},
    "launcher": {"type": "string", "minLength": 1},
    "device_target": {"type": "string", "minLength": 1},
    "hardware": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "artifact_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "compatibility_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "endpoint_contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operation", "transport", "adapter_call", "required_inputs", "outputs"],
        "properties": {
          "id": {"$ref": "vocabulary-v1.schema.json#/$defs/id"},
          "operation": {"$ref": "vocabulary-v1.schema.json#/$defs/operation"},
          "transport": {"const": "http"},
          "adapter_call": {"type": "string", "minLength": 1},
          "method": {"const": "POST"},
          "path": {"type": "string", "pattern": "^/"},
          "required_inputs": {"$ref": "vocabulary-v1.schema.json#/$defs/input_modalities"},
          "optional_inputs": {
            "type": "array", "uniqueItems": true,
            "items": {"$ref": "vocabulary-v1.schema.json#/$defs/input_modality"}
          },
          "outputs": {"$ref": "vocabulary-v1.schema.json#/$defs/modalities"},
          "streaming": {"type": "boolean"},
          "supports_tools": {"type": "boolean"},
          "description": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"transport": {"const": "http"}}},
           "then": {"required": ["method", "path"]}}
        ]
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://github\\.com/"},
        "revision": {
          "anyOf": [
            {"const": "latest"},
            {"type": "string", "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"}
          ]
        }
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "runtime_directory": {"type": "string"},
        "server_executable": {"type": "string"},
        "quantizer_executable": {"type": "string"},
        "build_targets": {"type": "array", "items": {"type": "string"}},
        "version_arguments": {"type": "array", "items": {"type": "string"}},
        "environment_group": {"type": "string"},
        "python_packages": {"type": "array", "items": {"type": "string"}},
        "cmake_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": {"type": "string"}
          }
        }
      }
    }
  }
}
